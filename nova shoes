<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>NOVA SHOES | Walk Your Way</title>

<style>

*{box-sizing:border-box;margin:0;padding:0}

body{background:#0c0c0c;color:white;font-family:Arial,sans-serif}

header{padding:20px 6%;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #333}

.logo{font-size:27px;font-weight:900;letter-spacing:3px;color:#d6b46a}

nav a{color:white;text-decoration:none;margin-left:12px;font-size:13px}

.hero{text-align:center;padding:90px 15px;background:linear-gradient(130deg,#171717,#332719)}

.hero small{color:#d6b46a;letter-spacing:4px}

.hero h1{font-size:46px;margin:20px 0}

.hero span{color:#d6b46a}

.hero p{color:#ccc;margin-bottom:25px}

.btn{background:#d6b46a;color:#111;border:0;padding:14px 23px;border-radius:5px;font-weight:bold;cursor:pointer;text-decoration:none;display:inline-block}

section{padding:55px 6%}

.heading{text-align:center;margin-bottom:30px}

.heading h2{font-size:27px}

.heading p{color:#aaa;margin-top:10px}

.filters{display:flex;justify-content:center;gap:9px;flex-wrap:wrap;margin-bottom:25px}

.filters button{background:#222;color:white;border:1px solid #555;padding:10px 16px;border-radius:20px}

.filters button.active{background:#d6b46a;color:#111}

.products{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}

.product{background:#1a1a1a;border:1px solid #333;border-radius:9px;overflow:hidden}

.product img{width:100%;height:160px;object-fit:cover}

.details{padding:12px}

.details h3{font-size:15px}

.price{color:#d6b46a;font-weight:bold;margin:10px 0}

.details button{width:100%;padding:11px;background:#d6b46a;border:0;border-radius:4px;font-weight:bold}

.cart,.checkout{background:#191919;padding:20px;border-radius:10px;margin-top:25px}

.cart h3,.checkout h3{color:#d6b46a;margin-bottom:16px}

.cart-item{display:flex;justify-content:space-between;gap:8px;margin:12px 0;font-size:13px}

.cart-item button{background:none;color:#ff7777;border:0}

.total{border-top:1px solid #444;padding-top:15px;margin-top:15px;font-weight:bold}

.checkout label{display:block;margin:15px 0 7px;color:#ddd;font-size:14px}

.checkout input,.checkout textarea,.checkout select{width:100%;padding:13px;background:#292929;color:white;border:1px solid #555;border-radius:5px;font-size:15px}

.checkout textarea{height:85px;resize:vertical}

.checkout .btn{width:100%;margin-top:20px}

.note{font-size:12px;color:#aaa;margin-top:12px;line-height:1.6}

.about{text-align:center;background:#171717}

.about p{color:#bbb;line-height:1.8;max-width:550px;margin:15px auto}

.contact{text-align:center}

.contact p{color:#bbb;margin:12px}

footer{text-align:center;background:#080808;padding:25px;color:#999;font-size:13px}

@media(min-width:700px){

.products{grid-template-columns:repeat(3,1fr)}

.product img{height:240px}

.hero h1{font-size:65px}

}

</style>

</head>

<body>

<header>

<div class="logo">NOVA.</div>

<nav>

<a href="#home">Home</a>

<a href="#shop">Shop</a>

<a href="#about">About</a>

<a href="#contact">Contact</a>

</nav>

</header>

<div class="hero" id="home">

<small>WELCOME TO NOVA SHOES</small>

<h1>WALK YOUR <span>WAY.</span></h1>

<p>Discover your style. Find your perfect pair.</p>

<a href="#shop" class="btn">SHOP COLLECTION</a>

</div>

<section id="shop">

<div class="heading">

<h2>OUR COLLECTION</h2>

<p>Find the perfect shoes for every moment.</p>

</div>

<div class="filters">

<button class="active" onclick="filter('All',this)">All</button>

<button onclick="filter('Sneakers',this)">Sneakers</button>

<button onclick="filter('Heels',this)">Heels</button>

<button onclick="filter('Casual',this)">Casual</button>

</div>

<div class="products" id="products"></div>

<div class="cart">

<h3>YOUR SHOPPING CART 🛍️</h3>

<div id="cartItems">Your cart is empty.</div>

<div class="total" id="total">Total: 0 ETB</div>

</div>

<div class="checkout">

<h3>DELIVERY & CHECKOUT</h3>

<label>Full name</label>

<input id="customer" placeholder="Enter your name">

<label>Phone number</label>

<input id="phone" type="tel" placeholder="09XXXXXXXX">

<label>Order method</label>

<select id="method" onchange="deliveryOption()">

<option value="Delivery">Home delivery</option>

<option value="Pickup">Store pickup</option>

</select>

<div id="addressBox">

<label>Delivery address</label>

<textarea id="address" placeholder="Enter your city, area, house number and location details"></textarea>

</div>

<label>Preferred payment method</label>

<select id="payment">

<option>Payment method to be confirmed</option>

<option>Cash on delivery (if available)</option>

<option>Bank transfer (if available)</option>

</select>

<label>Additional instructions</label>

<textarea id="instructions" placeholder="Shoe size, color or other requests"></textarea>

<div class="note">

Delivery fee: To be confirmed depending on your location.

Final delivery charges and payment arrangements will be confirmed through WhatsApp.

</div>

<button class="btn" onclick="order()">PLACE ORDER ON WHATSAPP</button>

</div>

</section>

<section class="about" id="about">

<div class="heading"><h2>ABOUT NOVA</h2></div>

<p>NOVA SHOES is all about style, comfort and confidence. Discover sneakers, elegant heels and casual shoes for every occasion.</p>

<p style="color:#d6b46a"><b>NOVA SHOES — WALK YOUR WAY.</b></p>

</section>

<section class="contact" id="contact">

<div class="heading"><h2>CONTACT US</h2></div>

<p>Questions about sizes, prices or delivery?</p>

<p>We're happy to help you find your perfect pair.</p>

</section>

<footer>

<p>© 2026 NOVA SHOES. All rights reserved.</p>

<p style="color:#d6b46a;margin-top:8px">WALK YOUR WAY.</p>

</footer>

<script>

const WHATSAPP_NUMBER="251900000000";

const shoes=[

{name:"Classic Street Sneakers",category:"Sneakers",price:2500,size:"All sizes available on request",image:"https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600"},

{name:"White Everyday Sneakers",category:"Sneakers",price:2800,size:"All sizes available on request",image:"https://images.unsplash.com/photo-1549298916-b41d501d3772?w=600"},

{name:"Urban Sport Sneakers",category:"Sneakers",price:3200,size:"All sizes available on request",image:"https://images.unsplash.com/photo-1552346154-21d32810aba3?w=600"},

{name:"Elegant Black Heels",category:"Heels",price:3500,size:"All sizes available on request",image:"https://images.unsplash.com/photo-1543163521-1bf539c55dd2?w=600"},

{name:"Classic Fashion Heels",category:"Heels",price:3800,size:"All sizes available on request",image:"https://images.unsplash.com/photo-1515347619252-60a4bf4fff4f?w=600"},

{name:"Everyday Casual Shoes",category:"Casual",price:2200,size:"All sizes available on request",image:"https://images.unsplash.com/photo-1525966222134-fcfa99b8ae77?w=600"}

];

let cart=[];

function display(items){

document.getElementById("products").innerHTML=items.map(s=>{

let i=shoes.indexOf(s);

return `

<div class="product">

<img src="${s.image}" alt="${s.name}">

<div class="details">

<h3>${s.name}</h3>

<div class="price">${s.price.toLocaleString()} ETB</div>

<button onclick="add(${i})">ADD TO CART +</button>

</div>

</div>`;

}).join("");

}

function filter(category,button){

document.querySelectorAll(".filters button").forEach(b=>b.classList.remove("active"));

button.classList.add("active");

display(category==="All"?shoes:shoes.filter(s=>s.category===category));

}

function add(i){

cart.push(i);

updateCart();

}

function removeItem(position){

cart.splice(position,1);

updateCart();

}

function updateCart(){

let area=document.getElementById("cartItems");

if(cart.length===0){

area.innerHTML="Your cart is empty.";

}else{

area.innerHTML=cart.map((i,pos)=>`

<div class="cart-item">

<span>${shoes[i].name}</span>

<span>${shoes[i].price.toLocaleString()} ETB

<button onclick="removeItem(${pos})">✕</button></span>

</div>`).join("");

}

let total=cart.reduce((sum,i)=>sum+shoes[i].price,0);

document.getElementById("total").innerText=

"Total: "+total.toLocaleString()+" ETB";

}

function deliveryOption(){

let method=document.getElementById("method").value;

document.getElementById("addressBox").style.display=

method==="Delivery"?"block":"none";

}

function order(){

if(cart.length===0){

alert("Please add shoes to your cart first!");

return;

}

let name=document.getElementById("customer").value.trim();

let phone=document.getElementById("phone").value.trim();

let method=document.getElementById("method").value;

let address=document.getElementById("address").value.trim();

let payment=document.getElementById("payment").value;

let instructions=document.getElementById("instructions").value.trim();

if(!name||!phone){

alert("Please enter your name and phone number.");

return;

}

if(method==="Delivery"&&!address){

alert("Please enter your delivery address.");

return;

}

let total=cart.reduce((sum,i)=>sum+shoes[i].price,0);

let message=

"HELLO NOVA SHOES! 🖤\n\n"+

"NEW ORDER\n"+

"Customer: "+name+"\n"+

"Phone: "+phone+"\n"+

"Order method: "+method+"\n";

if(method==="Delivery"){

message+="Delivery address: "+address+"\n";

}

message+="\nORDER DETAILS:\n";

cart.forEach(i=>{

message+=shoes[i].name+" - "+shoes[i].price+" ETB\n";

});

message+="\nTOTAL: "+total+" ETB\n"+

"Delivery fee: To be confirmed\n"+

"Payment: "+payment+"\n"+

"Additional instructions: "+(instructions||"None")+

"\n\nPlease confirm my order. Thank you!";

if(WHATSAPP_NUMBER==="251900000000"){

alert("Please set your real NOVA SHOES WhatsApp number in the code before accepting orders.");

return;

}

window.open(

"https://wa.me/"+WHATSAPP_NUMBER+

"?text="+encodeURIComponent(message),

"_blank"

);

}

display(shoes);

</script>

</body>

</html>